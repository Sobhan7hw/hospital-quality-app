<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <Geometry x:Key="SunIconGeometry">
                M12,8A4,4 0 1,0 16,12A4,4 0 0,0 12,8Z
        M12,2V4
        M12,20V22
        M2,12H4
        M20,12H22
        M4.9,4.9L6.3,6.3
        M17.7,17.7L19.1,19.1
        M4.9,19.1L6.3,17.7
        M17.7,4.9L19.1,6.3
        </Geometry>

        <Geometry x:Key="MoonIconGeometry">
                M13.5,3A8.5,8.5 0 1,0 21,11.5A6.5,6.5 0 0,1 13.5,3Z
        </Geometry>

        <Geometry x:Key="ChevronDownGeometry">
                M6,9L12,15L18,9
        </Geometry>

        <Style x:Key="SidebarMenuItemStyle"
                        TargetType="Button">
                <Setter Property="Background"
                                Value="Transparent"/>
                <Setter Property="Foreground"
                                Value="{DynamicResource TextOnSidebarBrush}"/>
                <Setter Property="FontFamily"
                                Value="{DynamicResource BodyFontFamily}"/>
                <Setter Property="FontSize"
                                Value="14"/>
                <Setter Property="FontWeight"
                                Value="Medium"/>
                <Setter Property="Cursor"
                                Value="Hand"/>
                <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                <Setter Property="Margin"
                                Value="0,3"/>
                <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="MenuBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="14,11">
                                                <ContentPresenter HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                                Value="True">
                                                        <Setter TargetName="MenuBorder"
                                                                        Property="Background"
                                                                        Value="{DynamicResource SidebarHoverBrush}"/>
                                                        <Setter Property="Foreground"
                                                                        Value="{DynamicResource TextOnSidebarHoverBrush}"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed"
                                                                Value="True">
                                                        <Setter TargetName="MenuBorder"
                                                                        Property="Background"
                                                                        Value="{DynamicResource SidebarPressedBrush}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="SidebarSectionHeaderStyle"
                        TargetType="ToggleButton">
                <Setter Property="Background"
                                Value="Transparent"/>
                <Setter Property="Foreground"
                                Value="{DynamicResource TextSecondaryOnSidebarBrush}"/>
                <Setter Property="FontFamily"
                                Value="{DynamicResource CaptionFontFamily}"/>
                <Setter Property="FontSize"
                                Value="13"/>
                <Setter Property="FontWeight"
                                Value="SemiBold"/>
                <Setter Property="Cursor"
                                Value="Hand"/>
                <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                <Setter Property="Margin"
                                Value="0,12,0,4"/>
                <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SectionBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10"
                                                Padding="12,8">
                                                <ContentPresenter HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                                Value="True">
                                                        <Setter TargetName="SectionBorder"
                                                                        Property="Background"
                                                                        Value="{DynamicResource SidebarHoverBrush}"/>
                                                        <Setter Property="Foreground"
                                                                        Value="{DynamicResource TextOnSidebarHoverBrush}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="ThemeToggleStyle"
                        TargetType="ToggleButton">
                <Setter Property="Width"
                                Value="58"/>
                <Setter Property="Height"
                                Value="30"/>
                <Setter Property="Cursor"
                                Value="Hand"/>
                <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                                <Border x:Name="ToggleBackground"
                                                        CornerRadius="15"
                                                        Background="#CBD5E1"/>

                                                <Canvas Width="58"
                                                                Height="30">
                                                        <Border x:Name="ToggleThumb"
                                                                Canvas.Left="3"
                                                                Canvas.Top="3"
                                                                Width="24"
                                                                Height="24"
                                                                CornerRadius="12"
                                                                Background="White">
                                                                <Grid>
                                                                        <Path x:Name="SunIcon"
                                                                              Data="{StaticResource SunIconGeometry}"
                                                                              Width="14"
                                                                              Height="14"
                                                                              Stretch="Uniform"
                                                                              Fill="Transparent"
                                                                              Stroke="#F59E0B"
                                                                              StrokeThickness="1.7"/>

                                                                        <Path x:Name="MoonIcon"
                                                                              Data="{StaticResource MoonIconGeometry}"
                                                                              Width="13"
                                                                              Height="13"
                                                                              Stretch="Uniform"
                                                                              Fill="#FDE68A"
                                                                              Visibility="Collapsed"/>
                                                                </Grid>
                                                        </Border>
                                                </Canvas>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked"
                                                                Value="True">
                                                        <Setter TargetName="ToggleBackground"
                                                                        Property="Background"
                                                                        Value="#1D4ED8"/>
                                                        <Setter TargetName="ToggleThumb"
                                                                        Property="Background"
                                                                        Value="#0F172A"/>
                                                        <Setter TargetName="SunIcon"
                                                                        Property="Visibility"
                                                                        Value="Collapsed"/>
                                                        <Setter TargetName="MoonIcon"
                                                                        Property="Visibility"
                                                                        Value="Visible"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

</ResourceDictionary>